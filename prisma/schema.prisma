generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  password              String
  firstName             String
  lastName              String?
  phoneNumber           String?
  role                  UserRole       @default(TOURIST)
  profileImage          String?
  bio                   String?
  country               String?
  city                  String?
  preferredLanguage     String?        @default("am")
  newsletterOptIn       Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastLoginAt           DateTime?
  bookings              Booking[]
  experienceSubmissions Experience[]   @relation("ExperienceSubmissions")
  notifications         Notification[]
  orders                Order[]
  productSubmissions    Product[]      @relation("ProductSubmissions")
  reviews               Review[]

  @@map("users")
}

model Cottage {
  id              String       @id @default(cuid())
  name            String
  description     String
  pricePerNight   Decimal      @db.Decimal(10, 2)
  capacity        Int          @default(2)
  bedrooms        Int          @default(1)
  beds            Int          @default(1)
  bathrooms       Int          @default(1)
  hasTelescope    Boolean      @default(false)
  hasFireplace    Boolean      @default(false)
  hasPrivateDeck  Boolean      @default(false)
  hasKitchenette  Boolean      @default(false)
  hasHeatedFloors Boolean      @default(false)
  hasWifi         Boolean      @default(false)
  imageUrls       String[]     @default([])
  thumbnailUrl    String?
  isAvailable     Boolean      @default(true)
  totalUnits      Int          @default(1)
  availableUnits  Int          @default(1)
  altitude        Int?
  viewDescription String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bookings        Booking[]
  experiences     Experience[]
  links           Link[]
  media           Media[]

  @@map("cottages")
}

model Experience {
  id                String            @id @default(cuid())
  name              String
  description       String
  type              ExperienceType
  price             Decimal           @db.Decimal(10, 2)
  duration          Int?
  capacity          Int               @default(10)
  startTime         String?
  endTime           String?
  difficultyLevel   String?
  ageRequirement    Int?              @default(0)
  includedItems     String[]          @default([])
  isActive          Boolean           @default(true)
  maxBookingsPerDay Int?              @default(5)
  publicationStatus PublicationStatus @default(PUBLISHED)
  rejectionReason   String?
  submittedById     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cottageId         String?
  bookings          Booking[]
  cottage           Cottage?          @relation(fields: [cottageId], references: [id])
  submittedBy       User?             @relation("ExperienceSubmissions", fields: [submittedById], references: [id])
  links             Link[]
  media             Media[]
  reviews           Review[]

  @@index([submittedById])
  @@map("experiences")
}

model Booking {
  id                 String         @id @default(cuid())
  checkIn            DateTime
  checkOut           DateTime
  bookingDate        DateTime       @default(now())
  guestCount         Int            @default(1)
  specialRequests    String?
  amount             Decimal        @db.Decimal(10, 2)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod? @default(CHAPA)
  paymentTxRef       String?        @unique
  paymentVerifiedAt  DateTime?
  paymentData        Json?
  paymentWebhookData Json?
  paymentRefundedAt  DateTime?
  paymentRefundData  Json?
  status             BookingStatus  @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  userId             String
  cottageId          String
  experienceId       String?
  orderId            String?        @unique
  cottage            Cottage        @relation(fields: [cottageId], references: [id])
  experience         Experience?    @relation(fields: [experienceId], references: [id])
  order              Order?         @relation(fields: [orderId], references: [id])
  user               User           @relation(fields: [userId], references: [id])
  review             Review?

  @@index([userId])
  @@index([paymentTxRef])
  @@map("bookings")
}

model Product {
  id                String            @id @default(cuid())
  name              String
  description       String
  price             Decimal           @db.Decimal(10, 2)
  category          ProductCategory
  stock             Int               @default(0)
  minimumStock      Int               @default(5)
  producerName      String            @default("Choke Mountains Community")
  producerLocation  String            @default("West Gojam Zone, Amhara Region, Ethiopia")
  isOrganic         Boolean           @default(true)
  imageUrls         String[]          @default([])
  thumbnailUrl      String?
  weight            Decimal?          @db.Decimal(8, 2)
  harvestDate       DateTime?
  expiryDate        DateTime?
  isActive          Boolean           @default(true)
  publicationStatus PublicationStatus @default(PUBLISHED)
  rejectionReason   String?
  submittedById     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  links             Link[]
  media             Media[]
  orderItems        OrderItem[]
  submittedBy       User?             @relation("ProductSubmissions", fields: [submittedById], references: [id])

  @@index([submittedById])
  @@map("products")
}

model Media {
  id           String      @id @default(cuid())
  title        String
  type         MediaType
  url          String
  provider     String?
  videoId      String?
  scope        MediaScope  @default(GALLERY)
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  mimeType     String?
  sizeBytes    Int?
  fileName     String?
  altText      String?
  caption      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cottageId    String?
  experienceId String?
  productId    String?
  page         String?
  section      String?
  cottage      Cottage?    @relation(fields: [cottageId], references: [id], onDelete: Cascade)
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([cottageId])
  @@index([experienceId])
  @@index([productId])
  @@index([page, section])
  @@map("media")
}

model Link {
  id           String      @id @default(cuid())
  type         LinkType
  title        String
  url          String
  description  String?
  openInNewTab Boolean     @default(true)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cottageId    String?
  experienceId String?
  productId    String?
  cottage      Cottage?    @relation(fields: [cottageId], references: [id], onDelete: Cascade)
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cottageId])
  @@index([experienceId])
  @@index([productId])
  @@map("links")
}

model Order {
  id                 String         @id @default(cuid())
  userId             String
  totalAmount        Decimal        @db.Decimal(10, 2)
  status             OrderStatus    @default(PENDING)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod? @default(CHAPA)
  paymentTxRef       String?        @unique
  paymentVerifiedAt  DateTime?
  paymentData        Json?
  paymentWebhookData Json?
  shippingAddress    String?
  shippingCity       String?
  shippingRegion     String?
  shippingCountry    String?        @default("Ethiopia")
  trackingNumber     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deliveredAt        DateTime?
  booking            Booking?
  items              OrderItem[]
  user               User           @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int      @default(1)
  priceAtTime Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id           String      @id @default(cuid())
  rating       Int         @default(5)
  comment      String?
  userId       String
  bookingId    String?     @unique
  experienceId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  booking      Booking?    @relation(fields: [bookingId], references: [id])
  experience   Experience? @relation(fields: [experienceId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean   @default(false)
  actionUrl String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model InvestmentMilestone {
  id           String    @id @default(cuid())
  title        String
  description  String
  targetAmount Decimal   @db.Decimal(15, 2)
  raisedAmount Decimal   @default(0) @db.Decimal(15, 2)
  status       String    @default("PLANNED")
  startDate    DateTime?
  endDate      DateTime?
  completedAt  DateTime?
  documents    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("investment_milestones")
}

model PaymentLog {
  id          String   @id @default(cuid())
  bookingId   String?
  orderId     String?
  txRef       String?
  status      String
  error       String?
  timestamp   DateTime @default(now())
  webhookData Json?

  @@map("payment_logs")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum UserRole {
  TOURIST
  ADMIN
  INVESTOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CHAPA
  TELEBIRR
  CBE_BIRR
  BANK_CARD
  CASH
}

enum ExperienceType {
  STARGAZING
  TREKKING
  CITY_LIGHTS
  SUNRISE_SUNSET
  CULTURAL_TOUR
  BIRD_WATCHING
}

enum ProductCategory {
  HONEY
  COFFEE
  CRAFTS
  SPICES
  BAMBOO
  OTHER
  FOOD
  DAIRY
  RESTAURANT
  GUEST_HOUSE
  MART
  APPAREL
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaScope {
  GALLERY
  COTTAGE
  EXPERIENCE
  PRODUCT
  PAGE_BACKGROUND
}

enum LinkType {
  WEBSITE
  BOOKING
  PURCHASE
  LOCATION
  SOCIAL
  VIDEO
  OTHER
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  REJECTED
}
