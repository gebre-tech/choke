# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git and must never be committed.

# Local PostgreSQL connection string
DATABASE_URL="postgresql://postgres:2794@localhost:5432/choke_db"

# Chapa payment gateway (test keys start with CHASECK_TEST-)
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_ENCRYPTION_KEY=""
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Webhook secret you configure in the Chapa dashboard (Webhooks tab).
# If not set, CHAPA_SECRET_KEY is used to verify webhook signatures.
CHAPA_WEBHOOK_SECRET=""

# Public URL of this app (used to build Chapa callback/return URLs)
APP_URL="http://localhost:3000"

# Deprecated alias kept for compatibility
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# Must be set in production.
AUTH_SECRET=""